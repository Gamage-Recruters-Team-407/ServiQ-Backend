PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/serviq?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRES_IN=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ServiQ Support <your-gmail@gmail.com>"
